{
  "name": "yetimind",
  "version": "0.1.0",
  "description": "YetiMind — a streaming terminal AI assistant",
  "main": "dist/presentation/cli/index.js",
  "bin": {
    "yetimind": "dist/presentation/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run",
    "benchmark": "ts-node tests/benchmark.ts",
    "start": "node dist/presentation/cli/index.js",
    "dev": "tsc && node dist/presentation/cli/index.js",
    "dev:verbose": "tsc && node dist/presentation/cli/index.js --verbose"
  },
  "keywords": [
    "ai",
    "terminal",
    "assistant",
    "llm",
    "streaming"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.0.1",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "node-pty": "^1.1.0",
    "strip-ansi": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
